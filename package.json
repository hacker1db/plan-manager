{
  "name": "plan-manager",
  "version": "0.3.0",
  "description": "Local Markdown plan library, CLI, dashboard, and private hosted app",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "pnpm build:web",
    "build:cli": "cd cli && go build -o bin/plan ./cmd/plan",
    "build:web": "node scripts/check-hosted-env.mjs && node scripts/sync-dashboard-style.mjs && vite build && node scripts/check-client-bundle.mjs",
    "dev": "cd cli && go run ./cmd/plan serve --foreground",
    "dev:web": "node scripts/sync-dashboard-style.mjs && vite dev",
    "start:web": "vite preview",
    "typecheck": "pnpm typecheck:web",
    "typecheck:cli": "cd cli && go vet ./...",
    "typecheck:web": "node scripts/sync-dashboard-style.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm test:cli && pnpm test:lib && pnpm test:web",
    "test:web": "node scripts/sync-dashboard-style.mjs && svelte-kit sync && node --import tsx --test 'test/hosted/**/*.test.ts' 'test/hosted/**/*.test.tsx'",
    "test:lib": "TSX_TSCONFIG_PATH=tsconfig.tests.json node --import tsx --test 'test/lib/*.js'",
    "test:cli": "cd cli && go test ./...",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-hosted.ts",
    "test:contracts": "sh cli/scripts/contracts.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.1.0",
    "dompurify": "3.4.17",
    "js-yaml": "^4.3.2",
    "mermaid": "^11.17.2",
    "nanoid": "^5.0.7",
    "proper-lockfile": "4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "@workos/authkit-sveltekit": "0.3.0",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
