{
  "name": "plan-manager",
  "version": "0.3.0",
  "description": "Plan Manager: the private hosted app and shared dashboard assets (the plan CLI lives in cli/)",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm build:web",
    "build:web": "node scripts/sync-dashboard-style.mjs && next build",
    "dev:web": "node scripts/sync-dashboard-style.mjs && next dev",
    "start:web": "next start",
    "typecheck": "pnpm typecheck:web",
    "typecheck:web": "node scripts/sync-dashboard-style.mjs && next typegen && tsc --noEmit",
    "test": "pnpm test:web",
    "test:web": "node scripts/sync-dashboard-style.mjs && node --import tsx --test 'test/lib/**/*.test.ts' 'test/lib/**/*.test.tsx' 'test/hosted/**/*.test.ts' 'test/hosted/**/*.test.tsx'",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-hosted.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.1.0",
    "dompurify": "3.4.17",
    "js-yaml": "^4.1.0",
    "mermaid": "^11.17.2",
    "nanoid": "^5.0.7",
    "next": "16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
