{
  "name": "plan-manager",
  "version": "0.3.0",
  "description": "Local Markdown plan library, CLI, dashboard, and private hosted app",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "plan": "./bin/plan"
  },
  "scripts": {
    "prepare": "pnpm build:cli",
    "build": "pnpm build:cli && pnpm build:web",
    "build:cli": "tsc --project tsconfig.cli.json && node scripts/copy-dashboard-assets.mjs",
    "build:web": "node scripts/sync-dashboard-style.mjs && vite build && node scripts/check-client-bundle.mjs",
    "dev": "tsx watch scripts/dev.mts serve --foreground",
    "dev:web": "node scripts/sync-dashboard-style.mjs && vite dev",
    "start:web": "vite preview",
    "typecheck": "pnpm typecheck:cli && pnpm typecheck:web",
    "typecheck:cli": "tsc --project tsconfig.cli.json --noEmit",
    "typecheck:web": "node scripts/sync-dashboard-style.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm build:cli && node --test 'test/lib/*.js' 'test/cli/*.js' && node --import tsx --test 'test/cli/**/*.test.ts' && pnpm test:web",
    "test:web": "node scripts/sync-dashboard-style.mjs && svelte-kit sync && node --import tsx --test 'test/hosted/**/*.test.ts' 'test/hosted/**/*.test.tsx'",
    "test:lib": "pnpm build:cli && node --test 'test/lib/*.js'",
    "test:cli": "pnpm build:cli && node --test 'test/cli/*.js'",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate-hosted.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.22.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.1.0",
    "dompurify": "3.4.17",
    "js-yaml": "^4.3.2",
    "mermaid": "^11.17.2",
    "nanoid": "^5.0.7",
    "proper-lockfile": "4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "6.3.4",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "8.3.4"
  }
}
