{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hacker1db/plan-manager/config/env.contract.schema.json",
  "title": "Plan Manager environment contract",
  "description": "Editor schema for config/env.contract.json. scripts/env-contract.mjs enforces the same rules at build and test time (test/hosted/env-contract.test.ts keeps them in step).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "storagePolicy", "variables"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "storagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secret", "config"],
      "properties": {
        "secret": { "$ref": "#/$defs/storageByTarget" },
        "config": { "$ref": "#/$defs/storageByTarget" }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variable" }
    }
  },
  "$defs": {
    "target": { "enum": ["production", "preview", "development"] },
    "storage": { "enum": ["plain", "encrypted", "sensitive"] },
    "storageByTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "preview", "development"],
      "properties": {
        "production": { "$ref": "#/$defs/storage" },
        "preview": { "$ref": "#/$defs/storage" },
        "development": { "$ref": "#/$defs/storage" }
      }
    },
    "validator": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "const": "nonEmpty" } } },
        { "type": "object", "additionalProperties": false, "required": ["id"], "properties": { "id": { "const": "csvNonEmpty" } } },
        { "type": "object", "additionalProperties": false, "required": ["id", "min"], "properties": { "id": { "const": "minLength" }, "min": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "store", "requiredIn", "sensitivity", "exposure", "group", "validator", "ciFixture", "owner", "docs", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "store": { "enum": ["vercel", "github-environment"] },
        "requiredIn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/target" } },
        "githubEnvironments": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sensitivity": { "enum": ["secret", "config"] },
        "exposure": { "enum": ["server", "ci"] },
        "group": { "enum": ["hosted", "cli", "health", "release"] },
        "validator": { "$ref": "#/$defs/validator" },
        "ciFixture": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
