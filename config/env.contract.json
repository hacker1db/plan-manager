{
  "$schema": "./env.contract.schema.json",
  "version": 1,
  "storagePolicy": {
    "secret": { "production": "sensitive", "preview": "sensitive", "development": "encrypted" },
    "config": { "production": "plain", "preview": "plain", "development": "plain" }
  },
  "variables": [
    {
      "name": "WORKOS_CLIENT_ID",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "config",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "ci-fixture-workos-client-id",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#vercel-environment-configuration",
      "description": "WorkOS AuthKit client ID for browser sessions."
    },
    {
      "name": "WORKOS_API_KEY",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "secret",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "ci-fixture-workos-api-key",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#vercel-environment-configuration",
      "description": "WorkOS API key for the environment (server-only secret)."
    },
    {
      "name": "WORKOS_COOKIE_PASSWORD",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "secret",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "minLength", "min": 32 },
      "ciFixture": "ci-fixture-cookie-password-not-real-0000",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#vercel-environment-configuration",
      "description": "Session cookie encryption password, at least 32 characters."
    },
    {
      "name": "WORKOS_REDIRECT_URI",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "config",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "https://plans.example.invalid/callback",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#vercel-environment-configuration",
      "description": "Exact browser callback URL ending in /callback."
    },
    {
      "name": "PLAN_MANAGER_OWNER_WORKOS_USER_IDS",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "config",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "csvNonEmpty" },
      "ciFixture": "ci-fixture-owner-user-id",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#access-and-uploads",
      "description": "Comma-separated WorkOS user IDs allowed to use the app."
    },
    {
      "name": "PLAN_MANAGER_WORKOS_AUTHKIT_DOMAIN",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "config",
      "exposure": "server",
      "group": "cli",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "https://auth.example.invalid",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#access-and-uploads",
      "description": "HTTPS origin of the AuthKit domain used for CLI device login."
    },
    {
      "name": "PLAN_MANAGER_WORKOS_CLI_CLIENT_ID",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "config",
      "exposure": "server",
      "group": "cli",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "ci-fixture-cli-client-id",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#access-and-uploads",
      "description": "Client ID of the public Plan Manager CLI Connect application."
    },
    {
      "name": "PLAN_MANAGER_WORKOS_CLI_AUDIENCE",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "config",
      "exposure": "server",
      "group": "cli",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "ci-fixture-cli-audience",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#access-and-uploads",
      "description": "Audience configured for the CLI application."
    },
    {
      "name": "DATABASE_URL",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "secret",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "postgres://db.example.invalid/ci-fixture",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#local-development",
      "description": "Neon Postgres connection string."
    },
    {
      "name": "BLOB_READ_WRITE_TOKEN",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "secret",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "ci-fixture-blob-token",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#access-and-uploads",
      "description": "Private Vercel Blob read/write token."
    },
    {
      "name": "PLAN_MANAGER_TOKEN_PEPPER",
      "store": "vercel",
      "requiredIn": ["production", "preview", "development"],
      "sensitivity": "secret",
      "exposure": "server",
      "group": "hosted",
      "validator": { "id": "nonEmpty" },
      "ciFixture": "ci-fixture-token-pepper",
      "owner": "hacker1db",
      "docs": "docs/hosting.md#access-and-uploads",
      "description": "Server-side pepper for hashing CLI upload tokens."
    },
    {
      "name": "VERCEL_TOKEN",
      "store": "github-environment",
      "requiredIn": [],
      "githubEnvironments": ["env-audit"],
      "sensitivity": "secret",
      "exposure": "ci",
      "group": "release",
      "validator": { "id": "nonEmpty" },
      "ciFixture": null,
      "owner": "hacker1db",
      "docs": "docs/operations/ci-cd.md#github-environments",
      "description": "Personal Vercel token for trusted workflows (GitHub environment secret, never in PR CI)."
    },
    {
      "name": "VERCEL_PROJECT_ID_PRODUCTION",
      "store": "github-environment",
      "requiredIn": [],
      "githubEnvironments": ["env-audit"],
      "sensitivity": "config",
      "exposure": "ci",
      "group": "release",
      "validator": { "id": "nonEmpty" },
      "ciFixture": null,
      "owner": "hacker1db",
      "docs": "docs/operations/ci-cd.md#github-environments",
      "description": "ID of the Git-disconnected production Vercel project (GitHub environment variable)."
    },
    {
      "name": "VERCEL_PROJECT_ID_PREVIEW",
      "store": "github-environment",
      "requiredIn": [],
      "githubEnvironments": ["env-audit"],
      "sensitivity": "config",
      "exposure": "ci",
      "group": "release",
      "validator": { "id": "nonEmpty" },
      "ciFixture": null,
      "owner": "hacker1db",
      "docs": "docs/operations/ci-cd.md#github-environments",
      "description": "ID of the Git-connected preview Vercel project (GitHub environment variable)."
    }
  ]
}
