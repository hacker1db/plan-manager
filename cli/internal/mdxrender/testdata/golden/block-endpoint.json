  "html": "<section class=\"pm-block pm-endpoint\"><header class=\"pm-endpoint-head\"><span class=\"pm-method pm-method-get\">GET</span><code class=\"pm-path\">/api/plans/:id</code><span class=\"pm-change pm-change-modified\">modified</span></header><div class=\"pm-endpoint-body\"><p>Returns rendered HTML for Markdown and MDX plans.</p></div><table class=\"pm-params\"><thead><tr><th>Param</th><th>In</th><th>Type</th><th>Notes</th></tr></thead><tbody><tr><td><code>id</code><span class=\"pm-required\">required</span></td><td>path</td><td><code>string</code></td><td>Plan id</td></tr><tr><td><code>q</code></td><td>query</td><td><del>string</del> → <code>number</code></td><td><span class=\"pm-change pm-change-modified\">modified</span></td></tr></tbody></table><div class=\"pm-example\"><span class=\"pm-example-label\">Request · application/json</span><pre><code>{\n  &quot;1&quot;: &quot;x&quot;,\n  &quot;2&quot;: true,\n  &quot;a&quot;: 1,\n  &quot;b&quot;: [\n    1,\n    2,\n    {\n      &quot;c&quot;: null\n    }\n  ]\n}</code></pre></div><div class=\"pm-example\"><span class=\"pm-example-label\"><span class=\"pm-status pm-status-2xx\">200</span> OK <span class=\"pm-change pm-change-added\">added</span></span><pre><code>{\n  &quot;format&quot;: &quot;mdx&quot;\n}</code></pre></div><div class=\"pm-example\"><span class=\"pm-example-label\"><span class=\"pm-status pm-status-4xx\">404</span>  </span></div><div class=\"pm-example\"><span class=\"pm-example-label\"><span class=\"pm-status pm-status-5xx\">500</span>  </span><pre><code>not json</code></pre></div><div class=\"pm-example\"><span class=\"pm-example-label\"><span class=\"pm-status pm-status-2xx\">201</span>  </span><pre><code>5</code></pre></div></section>\n<section class=\"pm-block pm-endpoint pm-deprecated\"><header class=\"pm-endpoint-head\"><span class=\"pm-method pm-method-delete\">DELETE</span><code class=\"pm-path\">/old</code><span class=\"pm-change pm-change-removed\">deprecated</span></header></section>