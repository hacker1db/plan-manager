# Copy to .env.local (git-ignored). None of these are secrets.
PLAN_MANAGER_SERVICE_URL=https://planmanager.hacker1db.dev
# The WorkOS client ID; must match PLAN_MANAGER_WORKOS_NATIVE_CLIENT_ID on the server.
PLAN_MANAGER_WORKOS_CLIENT_ID=client_XXXXXXXXXXXXXXXXXXXXXXXXXX
# Register this exact URI as a redirect in the WorkOS dashboard.
PLAN_MANAGER_WORKOS_REDIRECT_URI=dev.hacker1db.planmanager://callback
PLAN_MANAGER_BUNDLE_ID=dev.hacker1db.planmanager
# Set to 1 to preview with labeled offline sample data (no network, no sign-in).
PLAN_MANAGER_FIXTURES=0
# GitHub owner/name of the repo whose T3 Code project receives plan comments.
PLAN_MANAGER_T3_REPO=hacker1db/SecondBrain
# Apple Developer team used to sign device builds.
PLAN_MANAGER_APPLE_TEAM_ID=DYY5WB84FX
