{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "sourceMap": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["$app/types", "node"]
  },
  "include": [
    "vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.svelte",
    "test/**/*.ts",
    "test/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules/**",
    "dist/**"
  ]
}
