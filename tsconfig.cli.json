{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/routes/**",
    "src/lib/server/**",
    "src/lib/hosted/**",
    "src/lib/components/**",
    "src/hooks.server.ts",
    "src/env.ts",
    "src/app.d.ts"
  ]
}
